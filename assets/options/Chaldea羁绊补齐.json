{
  "option": {
    "自动补齐从者和羁绊礼装": {
      "type": "switch",
      "label": "自动补齐从者和羁绊礼装",
      "description": "按 Chaldea 编队后，利用剩余 COST 补齐从者和羁绊加成礼装，提高全队羁绊收益。保留助战及 Chaldea 指定的从者和礼装。",
      "default_case": "No",
      "cases": [
        {
          "name": "No",
          "label": "否",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"bond_completion_enabled": false}}
          }
        },
        {
          "name": "Yes",
          "label": "是",
          "option": ["补齐从者优先X星", "羁绊基础值", "使用本地从者库", "使用本地礼装库", "自动修改其他位置从者", "自动修改其他位置礼装"],
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"bond_completion_enabled": true}}
          }
        }
      ]
    },
    "补齐从者优先X星": {
      "type": "select",
      "label": "补齐从者优先星级",
      "description": "补入从者时优先选择该星级；没有合适从者时，再按 5→0 星查找。",
      "default": "5星",
      "cases": [
        {"name": "5星", "label": "5星", "pipeline_override": {"执行羁绊补齐自动编队": {"attach": {"preferred_rarity": 5}}}},
        {"name": "4星", "label": "4星", "pipeline_override": {"执行羁绊补齐自动编队": {"attach": {"preferred_rarity": 4}}}},
        {"name": "3星", "label": "3星", "pipeline_override": {"执行羁绊补齐自动编队": {"attach": {"preferred_rarity": 3}}}},
        {"name": "2星", "label": "2星", "pipeline_override": {"执行羁绊补齐自动编队": {"attach": {"preferred_rarity": 2}}}},
        {"name": "1星", "label": "1星", "pipeline_override": {"执行羁绊补齐自动编队": {"attach": {"preferred_rarity": 1}}}},
        {"name": "0星", "label": "0星", "pipeline_override": {"执行羁绊补齐自动编队": {"attach": {"preferred_rarity": 0}}}}
      ]
    },
    "使用本地从者库": {
      "type": "switch",
      "label": "使用本地从者库",
      "description": "使用“构建个人从者礼装库”保存的从者记录加快补齐；持有从者变化后请重新构建。无有效记录时自动扫描。",
      "default_case": "No",
      "cases": [
        {
          "name": "No",
          "label": "否",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"use_local_servant_inventory": false}}
          }
        },
        {
          "name": "Yes",
          "label": "是",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"use_local_servant_inventory": true}}
          }
        }
      ]
    },
    "使用本地礼装库": {
      "type": "switch",
      "label": "使用本地礼装库",
      "description": "使用“构建个人从者礼装库”保存的礼装记录加快补齐；持有礼装或满破状态变化后请重新构建。无有效记录时自动扫描。",
      "default_case": "No",
      "cases": [
        {
          "name": "No",
          "label": "否",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"use_local_equip_inventory": false}}
          }
        },
        {
          "name": "Yes",
          "label": "是",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"use_local_equip_inventory": true}}
          }
        }
      ]
    },
    "自动修改其他位置从者": {
      "type": "switch",
      "label": "允许更换未指定的从者",
      "description": "仅针对 Chaldea 未指定的位置。是：允许替换已有从者。否：保留已有从者，只补空位。",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "是",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"modify_unspecified_servants": true}}
          }
        },
        {
          "name": "No",
          "label": "否",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"modify_unspecified_servants": false}}
          }
        }
      ]
    },
    "自动修改其他位置礼装": {
      "type": "switch",
      "label": "允许更换未指定的礼装",
      "description": "仅针对 Chaldea 未指定的礼装。是：允许更换已装备礼装。否：保留已装备礼装，只补空位。",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "是",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"modify_unspecified_equips": true}}
          }
        },
        {
          "name": "No",
          "label": "否",
          "pipeline_override": {
            "执行羁绊补齐自动编队": {"attach": {"modify_unspecified_equips": false}}
          }
        }
      ]
    },
    "羁绊基础值": {
      "type": "input",
      "label": "关卡基础羁绊",
      "description": "填写关卡不含加成的羁绊点数（正整数），用于选择收益更高的礼装。",
      "inputs": [
        {
          "name": "bond_base",
          "label": "关卡基础羁绊",
          "default": "1200",
          "verify": "^[1-9][0-9]*$",
          "pipeline_type": "int"
        }
      ],
      "pipeline_override": {
        "执行羁绊补齐自动编队": {"attach": {"bond_base": "{bond_base}"}}
      }
    }
  }
}
