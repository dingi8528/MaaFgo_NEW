{
    "option": {
        "Chaldea导入手动输入": {
            "type": "input",
            "label": "Chaldea 队伍导入（可选）",
            "description": "填写 Chaldea 的分享链接、队伍ID、关卡ID，或点击浏览按钮从本地选择队伍 JSON 文件。下载过的队伍缓存文件名（config/Battle 下，如\"诺100奥_77210_94149047\"）也可以直接填。留空则使用默认策略。",
            "inputs": [
                {
                    "name": "chaldea_import_source",
                    "label": "分享链接 / 队伍ID / 关卡ID / 本地文件（留空=默认策略）",
                    "default": "",
                    "verify": ".*",
                    "input_type": "file"
                }
            ],
            "pipeline_override": {
                "原生自动战斗入口": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "auto_battle",
                            "custom_action_param": {
                                "chaldea_import_source": "{chaldea_import_source}",
                                "max_turns": 20
                            }
                        }
                    }
                },
                "原生自动战斗_多次入口": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "auto_battle_repeat",
                            "custom_action_param": {
                                "chaldea_import_source": "{chaldea_import_source}",
                                "max_turns": 20
                            }
                        }
                    }
                },
                "执行自动编队": {
                    "attach": {
                        "chaldea_import_source": "{chaldea_import_source}"
                    }
                }
            }
        },
        "自动编队礼装开关": {
            "type": "select",
            "label": "自动编成礼装",
            "description": "关闭后仅调整从者和助战位置，完成从者复核后直接确认编队。",
            "default": "是",
            "cases": [
                {
                    "name": "是",
                    "label": "是",
                    "pipeline_override": {
                        "执行自动编队": {"attach": {"auto_equip": true}}
                    }
                },
                {
                    "name": "否",
                    "label": "否",
                    "pipeline_override": {
                        "执行自动编队": {"attach": {"auto_equip": false}}
                    }
                }
            ]
        },
        "自动编队礼装缺失处理": {
            "type": "select",
            "label": "满破礼装缺失时",
            "description": "仅当 Chaldea 要求满破、数据库和图片资源均存在但仓库未找到时生效。",
            "default": "跳过礼装",
            "cases": [
                {
                    "name": "跳过礼装",
                    "label": "跳过该礼装",
                    "pipeline_override": {
                        "执行自动编队": {"attach": {"equip_missing_policy": "skip"}}
                    }
                },
                {
                    "name": "查找非满破礼装",
                    "label": "改查非满破版本",
                    "pipeline_override": {
                        "执行自动编队": {"attach": {"equip_missing_policy": "allow_non_limit_break"}}
                    }
                }
            ]
        }
    }
}
