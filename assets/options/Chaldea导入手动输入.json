{
    "option": {
        "原生自动战斗使用Chaldea队伍": {
            "type": "select",
            "label": "是否使用 Chaldea 队伍",
            "description": "选择助战后按编队方式检查或还原导入队伍，再进入战斗。无法按等级或技能区分同名从者，请将不用的个体放入保管室。\n >",
            "default": "否",
            "cases": [
                {
                    "name": "否",
                    "label": "否",
                    "pipeline_override": {
                        "Chaldea助战action": {
                            "attach": {
                                "chaldea_enabled": false
                            }
                        }
                    }
                },
                {
                    "name": "是",
                    "label": "是",
                    "option": [
                        "Chaldea导入手动输入",
                        "Chaldea编队方式"
                    ],
                    "pipeline_override": {
                        "Chaldea助战action": {
                            "attach": {
                                "chaldea_enabled": true
                            }
                        }
                    }
                }
            ]
        },
        "Chaldea导入手动输入": {
            "type": "input",
            "label": "Chaldea 队伍导入",
            "description": "必填。支持分享链接、队伍ID、关卡ID、本地 JSON，或 config/Battle 下的缓存文件名。",
            "inputs": [
                {
                    "name": "chaldea_import_source",
                    "label": "分享链接 / 队伍ID / 关卡ID / 本地文件",
                    "default": "",
                    "verify": ".*",
                    "input_type": "file"
                }
            ],
            "pipeline_override": {
                "原生自动战斗入口": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "auto_battle",
                            "custom_action_param": {
                                "chaldea_import_source": "{chaldea_import_source}",
                                "max_turns": 20
                            }
                        }
                    }
                },
                "原生自动战斗_多次入口": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "auto_battle_repeat",
                            "custom_action_param": {
                                "chaldea_import_source": "{chaldea_import_source}",
                                "max_turns": 20
                            }
                        }
                    }
                },
                "执行自动编队": {
                    "attach": {
                        "chaldea_import_source": "{chaldea_import_source}"
                    }
                },
                "执行手动编队检查": {
                    "attach": {
                        "chaldea_import_source": "{chaldea_import_source}"
                    }
                },
                "执行羁绊补齐自动编队": {
                    "attach": {
                        "chaldea_import_source": "{chaldea_import_source}"
                    }
                },
                "Chaldea助战action": {
                    "attach": {
                        "chaldea_import_source": "{chaldea_import_source}"
                    }
                }
            }
        },
        "Chaldea编队方式": {
            "type": "select",
            "label": "编队方式",
            "description": "手动仅核对从者；身份一致但位置不同会自动换位保存。自动会按导入数据完整编队。",
            "default": "手动",
            "cases": [
                {
                    "name": "手动",
                    "label": "手动",
                    "pipeline_override": {
                        "进本-编队处理": {
                            "next": [
                                "执行手动编队检查"
                            ]
                        },
                        "手动编队检查完成": {
                            "next": [
                                "进本-点击队伍确认"
                            ]
                        }
                    }
                },
                {
                    "name": "自动",
                    "label": "自动",
                    "option": [
                        "自动编队助战替代",
                        "自动编队礼装开关",
                        "自动补齐从者和羁绊礼装"
                    ],
                    "pipeline_override": {
                        "进本-编队处理": {
                            "next": [
                                "执行自动编队"
                            ]
                        },
                        "自动编队完成": {
                            "next": [
                                "进本-点击队伍确认"
                            ]
                        }
                    }
                }
            ]
        },
        "自动编队助战替代": {
            "type": "select",
            "label": "是否用助战代替编队数据",
            "description": "队伍未标记助战时，可用当前同名助战替代对应从者；无法识别或不匹配会停止任务。已标记助战时按数据校验。",
            "default": "否",
            "cases": [
                {
                    "name": "否",
                    "label": "否",
                    "pipeline_override": {
                        "执行自动编队": {
                            "attach": {
                                "use_support_substitution": false
                            }
                        },
                        "执行羁绊补齐自动编队": {
                            "attach": {
                                "use_support_substitution": false
                            }
                        }
                    }
                },
                {
                    "name": "是",
                    "label": "是",
                    "pipeline_override": {
                        "执行自动编队": {
                            "attach": {
                                "use_support_substitution": true
                            }
                        },
                        "执行羁绊补齐自动编队": {
                            "attach": {
                                "use_support_substitution": true
                            }
                        }
                    }
                }
            ]
        },
        "自动编队礼装开关": {
            "type": "select",
            "label": "自动编成礼装",
            "description": "关闭后只编排从者和助战，不更换礼装。",
            "default": "是",
            "cases": [
                {
                    "name": "是",
                    "label": "是",
                    "option": [
                        "自动编队礼装缺失处理"
                    ],
                    "pipeline_override": {
                        "执行自动编队": {
                            "attach": {
                                "auto_equip": true
                            }
                        }
                    }
                },
                {
                    "name": "否",
                    "label": "否",
                    "pipeline_override": {
                        "执行自动编队": {
                            "attach": {
                                "auto_equip": false
                            }
                        }
                    }
                }
            ]
        },
        "自动编队礼装缺失处理": {
            "type": "select",
            "label": "满破礼装缺失时",
            "description": "仅在指定的满破礼装未找到时生效。",
            "default": "查找非满破礼装",
            "cases": [
                {
                    "name": "跳过礼装",
                    "label": "跳过该礼装",
                    "pipeline_override": {
                        "执行自动编队": {
                            "attach": {
                                "equip_missing_policy": "skip"
                            }
                        }
                    }
                },
                {
                    "name": "查找非满破礼装",
                    "label": "改查非满破版本",
                    "pipeline_override": {
                        "执行自动编队": {
                            "attach": {
                                "equip_missing_policy": "allow_non_limit_break"
                            }
                        }
                    }
                }
            ]
        }
    }
}
